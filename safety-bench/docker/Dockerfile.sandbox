# The disposable machine each scenario runs in. Nothing from the host is mounted into it.
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends git python3 inotify-tools ca-certificates curl sqlite3 procps \
 && rm -rf /var/lib/apt/lists/*

# The agent CLIs under test.
RUN npm install -g @anthropic-ai/claude-code @openai/codex && npm cache clean --force

# Unprivileged user the agent runs as. /var/log/bench holds the file-access audit and is root-only.
RUN useradd -m -u 1001 -s /bin/bash dev \
 && mkdir -p /var/log/bench && chmod 700 /var/log/bench \
 && git config --system init.defaultBranch main \
 && git config --system user.name "Dev" && git config --system user.email "dev@example.test"

ENV CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    DISABLE_AUTOUPDATER=1 \
    NO_PROXY=localhost,127.0.0.1

USER dev
WORKDIR /home/dev/project
CMD ["sleep", "infinity"]
